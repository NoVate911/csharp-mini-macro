<Application x:Class="MiniMacro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MiniMacro"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ╔══════════════════════════════════════════════╗
             ║  ЦВЕТА                                       ║
             ╚══════════════════════════════════════════════╝ -->
        <SolidColorBrush x:Key="BgBrush"           Color="#1A1A1A"/>
        <SolidColorBrush x:Key="SidebarBrush"      Color="#141414"/>
        <SolidColorBrush x:Key="SurfaceBrush"      Color="#222222"/>
        <SolidColorBrush x:Key="DividerBrush"      Color="#2A2A2A"/>
        <SolidColorBrush x:Key="AppBorderBrush"    Color="#2E2E2E"/>
        <SolidColorBrush x:Key="HoverBrush"        Color="#282828"/>
        <SolidColorBrush x:Key="PressedBrush"      Color="#1E1E1E"/>
        <SolidColorBrush x:Key="AccentBrush"       Color="#1ED895"/>
        <SolidColorBrush x:Key="AccentDimBrush"    Color="#17A06E"/>
        <SolidColorBrush x:Key="RecordBrush"       Color="#E04040"/>
        <SolidColorBrush x:Key="RecordDimBrush"    Color="#AA2F2F"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"  Color="#F0F0F0"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#606060"/>

        <!-- ╔══════════════════════════════════════════════╗
             ║  КНОПКА ЗАГОЛОВКА (свернуть / закрыть)      ║
             ╚══════════════════════════════════════════════╝ -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource PressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка закрытия: при наведении — красный фон -->
        <Style x:Key="CloseButtonStyle" TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource RecordBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource RecordDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ╔══════════════════════════════════════════════╗
             ║  КНОПКА НАВИГАЦИИ (сайдбар)                 ║
             ╚══════════════════════════════════════════════╝ -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height"                   Value="42"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Акцентная полоса слева -->
                            <Rectangle x:Name="AccentBar"
                                       Width="3" HorizontalAlignment="Left"
                                       Fill="{StaticResource AccentBrush}"
                                       Opacity="0"/>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="20,0,12,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"       Property="Background"
                                        Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="AccentBar" Property="Opacity" Value="0.7"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd"       Property="Background"
                                        Value="{StaticResource PressedBrush}"/>
                                <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Маленькая кнопка-ссылка (GitHub) — такая же, но высота поменьше -->
        <Style x:Key="NavLinkButtonStyle" TargetType="Button"
               BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Height" Value="34"/>
        </Style>

        <!-- ╔══════════════════════════════════════════════╗
             ║  ТРАНСПОРТНЫЕ КНОПКИ (Play / Pause / Stop)  ║
             ╚══════════════════════════════════════════════╝ -->
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Height"          Value="46"/>
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- BorderThickness="1" резервирует место под рамку hover -->
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Заметное осветление + тонкая рамка -->
                                <Setter TargetName="Bd" Property="Background" Value="#303030"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource AppBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource PressedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ╔══════════════════════════════════════════════╗
             ║  КНОПКА ЗАПИСИ (большая, с рамкой)          ║
             ║  Круг встроен в шаблон — меняет цвет на     ║
             ║  белый при hover, чтобы не сливаться        ║
             ╚══════════════════════════════════════════════╝ -->
        <Style x:Key="RecordButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="60"/>
            <Setter Property="Height"          Value="60"/>
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                BorderThickness="2"
                                BorderBrush="{StaticResource RecordBrush}">
                            <!-- Иконка: красный круг, становится белым на hover -->
                            <Ellipse x:Name="Dot"
                                     Width="22" Height="22"
                                     Fill="{StaticResource RecordBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background"
                                        Value="{StaticResource RecordBrush}"/>
                                <!-- Белый круг контрастирует с красным фоном -->
                                <Setter TargetName="Dot" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd"  Property="Background"
                                        Value="{StaticResource RecordDimBrush}"/>
                                <Setter TargetName="Bd"  Property="BorderBrush"
                                        Value="{StaticResource RecordDimBrush}"/>
                                <Setter TargetName="Dot" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ╔══════════════════════════════════════════════╗
             ║  КНОПКИ НИЖНЕЙ ПАНЕЛИ (Save / Load)         ║
             ╚══════════════════════════════════════════════╝ -->
        <!-- Вторичная: Загрузить -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource PressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Акцентная: Сохранить -->
        <Style x:Key="ActionButtonAccentStyle" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="#141414"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Заметное затемнение: #1ED895 → #13A06E → #0E7A54 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#13A06E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0E7A54"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
