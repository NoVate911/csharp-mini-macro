<Window x:Class="MiniMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiniMacro"
        mc:Ignorable="d"
        Title="Mini Macro"
        Height="480" Width="680"
        MinHeight="480" MinWidth="680"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="logo.ico">

    <!-- Внешняя рамка окна (1px бордер вместо системного chrome) -->
    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>  <!-- Заголовок -->
                <RowDefinition Height="*"/>   <!-- Контент -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════
                 ЗАГОЛОВОК ОКНА
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="0"
                  Background="{StaticResource SidebarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Иконка + название -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="logo.ico" Width="16" Height="16" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Mini Macro"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Кнопки управления окном -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Click="Minimize_Click" ToolTip="Свернуть">
                        <!-- Иконка: горизонтальная черта -->
                        <Path Data="M 5,8 L 11,8"
                              Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Click="Close_Click" ToolTip="Закрыть">
                        <!-- Иконка: крестик -->
                        <Path Data="M 4.5,4.5 L 11.5,11.5 M 11.5,4.5 L 4.5,11.5"
                              Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════
                 ОСНОВНОЙ КОНТЕНТ
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>  <!-- Сайдбар -->
                    <ColumnDefinition Width="1"/>    <!-- Разделитель -->
                    <ColumnDefinition Width="*"/>    <!-- Рабочая область -->
                </Grid.ColumnDefinitions>

                <!-- ────────────────────────────────────────
                     САЙДБАР
                ──────────────────────────────────────── -->
                <Grid Grid.Column="0" Background="{StaticResource SidebarBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>   <!-- Навигация -->
                        <RowDefinition Height="Auto"/> <!-- Футер -->
                    </Grid.RowDefinitions>

                    <!-- Навигация -->
                    <StackPanel Grid.Row="0" Margin="0,12,0,0">

                        <!-- Библиотека -->
                        <Button Style="{StaticResource NavButtonStyle}"
                                Click="Library_Click"
                                ToolTip="Библиотека макросов">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                    <!-- Иконка: три горизонтальные линии (список) -->
                                    <Path Data="M 1,4 L 15,4 M 1,8 L 15,8 M 1,12 L 15,12"
                                          Stroke="{Binding Foreground,
                                              RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Библиотека"
                                           FontFamily="Segoe UI" FontSize="13"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Настройки -->
                        <Button Style="{StaticResource NavButtonStyle}"
                                Margin="0,2,0,0"
                                Click="Settings_Click"
                                ToolTip="Настройки">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                    <!-- Иконка: ползунки (settings / sliders) -->
                                    <Path Data="M 1,4 L 5,4 M 9,4 L 15,4
                                                M 1,12 L 7,12 M 11,12 L 15,12
                                                M 7,2.5 L 7,5.5
                                                M 9,10.5 L 9,13.5"
                                          Stroke="{Binding Foreground,
                                              RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Настройки"
                                           FontFamily="Segoe UI" FontSize="13"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Футер сайдбара -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <Rectangle Height="1"
                                   Fill="{StaticResource DividerBrush}"
                                   Margin="12,0,12,12"/>
                        <TextBlock Text="v0.1.0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Margin="20,0,0,2"/>
                        <TextBlock Text="NoVate Source"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Margin="20,0,0,8"/>

                        <!-- GitHub -->
                        <Button Style="{StaticResource NavLinkButtonStyle}"
                                Click="GitHub_Click" ToolTip="Открыть репозиторий на GitHub">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                                    <!-- GitHub Octocat (упрощённый) -->
                                    <Path Fill="{Binding Foreground,
                                              RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M 8,0.5 C 3.86,0.5 0.5,3.86 0.5,8
                                                C 0.5,11.31 2.58,14.1 5.5,15.12
                                                C 5.87,15.18 6,14.95 6,14.75 L 6,13.43
                                                C 3.96,13.87 3.52,12.51 3.52,12.51
                                                C 3.18,11.62 2.69,11.38 2.69,11.38
                                                C 2.01,10.93 2.74,10.94 2.74,10.94
                                                C 3.49,10.99 3.88,11.71 3.88,11.71
                                                C 4.55,12.87 5.59,12.54 6.02,12.36
                                                C 6.09,11.88 6.28,11.55 6.49,11.37
                                                C 4.87,11.19 3.17,10.56 3.17,7.78
                                                C 3.17,6.94 3.47,6.25 3.9,5.71
                                                C 3.82,5.52 3.55,4.74 3.97,3.67
                                                C 3.97,3.67 4.6,3.47 6.01,4.44
                                                C 6.6,4.28 7.3,4.2 8,4.2
                                                C 8.7,4.2 9.4,4.28 9.99,4.44
                                                C 11.4,3.47 12.03,3.67 12.03,3.67
                                                C 12.45,4.74 12.18,5.52 12.1,5.71
                                                C 12.53,6.25 12.83,6.94 12.83,7.78
                                                C 12.83,10.57 11.13,11.19 9.5,11.36
                                                C 9.76,11.58 10,12.02 10,12.71 L 10,14.75
                                                C 10,14.95 10.13,15.19 10.5,15.12
                                                C 13.42,14.1 15.5,11.31 15.5,8
                                                C 15.5,3.86 12.14,0.5 8,0.5 Z"
                                          Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Text="GitHub"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Вертикальный разделитель -->
                <Rectangle Grid.Column="1" Fill="{StaticResource DividerBrush}"/>

                <!-- ────────────────────────────────────────
                     РАБОЧАЯ ОБЛАСТЬ
                ──────────────────────────────────────── -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>    <!-- Центр: макрос + транспорт -->
                        <RowDefinition Height="Auto"/> <!-- Нижняя панель: Save / Load -->
                    </Grid.RowDefinitions>

                    <!-- Центральная зона -->
                    <StackPanel Grid.Row="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <!-- Текущий макрос -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,44">
                            <TextBlock Text="ТЕКУЩИЙ МАКРОС"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI" FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,7"/>
                            <TextBlock x:Name="MacroNameText"
                                       Text="— не выбран —"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="Segoe UI" FontSize="20"
                                       FontWeight="Light"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Транспортные кнопки -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <!-- Запись (круг встроен в шаблон стиля) -->
                            <Button Style="{StaticResource RecordButtonStyle}"
                                    Margin="0,0,14,0" ToolTip="Начать запись"/>

                            <!-- Воспроизведение -->
                            <Button Style="{StaticResource TransportButtonStyle}"
                                    Margin="0,0,6,0" ToolTip="Воспроизвести">
                                <!-- Треугольник (play) -->
                                <Path Data="M 5,3 L 14,8 L 5,13 Z"
                                      Fill="{StaticResource AccentBrush}"/>
                            </Button>

                            <!-- Пауза -->
                            <Button Style="{StaticResource TransportButtonStyle}"
                                    Margin="0,0,6,0" ToolTip="Пауза">
                                <!-- Две вертикальные полосы -->
                                <Path Data="M 4,3 L 7,3 L 7,13 L 4,13 Z
                                            M 9,3 L 12,3 L 12,13 L 9,13 Z"
                                      Fill="{StaticResource TextPrimaryBrush}"/>
                            </Button>

                            <!-- Стоп -->
                            <Button Style="{StaticResource TransportButtonStyle}"
                                    ToolTip="Остановить">
                                <!-- Квадрат (stop) -->
                                <Rectangle Width="13" Height="13"
                                           Fill="{StaticResource TextPrimaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Нижняя панель -->
                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="20,14">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <!-- Загрузить -->
                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Margin="0,0,8,0"
                                    ToolTip="Загрузить макрос из файла">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                        <!-- Иконка: стрелка вверх (открыть) -->
                                        <Path Data="M 8,11 L 8,2 M 4,6 L 8,2 L 12,6
                                                    M 2,13 L 14,13"
                                              Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent"/>
                                    </Viewbox>
                                    <TextBlock Text="Загрузить"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontFamily="Segoe UI" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Сохранить (акцент) -->
                            <Button Style="{StaticResource ActionButtonAccentStyle}"
                                    ToolTip="Сохранить макрос в файл">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                        <!-- Иконка: стрелка вниз (сохранить) -->
                                        <Path Data="M 8,2 L 8,11 M 4,7 L 8,11 L 12,7
                                                    M 2,13 L 14,13"
                                              Stroke="#141414"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent"/>
                                    </Viewbox>
                                    <TextBlock Text="Сохранить"
                                               Foreground="#141414"
                                               FontFamily="Segoe UI" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
