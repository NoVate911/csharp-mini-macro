<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <RootNamespace>MiniMacro</RootNamespace>
    <AssemblyName>MiniMacro</AssemblyName>
    <AssemblyTitle>Mini Macro</AssemblyTitle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Authors>NoVate Source</Authors>
    <Company>NoVate Source</Company>
    <Product>Mini Macro</Product>
    <Description>Лёгкая программа для записи и воспроизведения макросов клавиатуры и мыши.</Description>
    <Version>0.1.0</Version>
    <ApplicationIcon>logo.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net48'">
    <DefineConstants>LEGACY</DefineConstants>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- logo.ico как встроенный ресурс: нужен для Window.Icon и ApplicationIcon -->
    <Resource Include="logo.ico"/>
  </ItemGroup>

</Project>
