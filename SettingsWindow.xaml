<Window x:Class="MiniMacro.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        PreviewKeyDown="Window_PreviewKeyDown"
        Height="500" Width="500"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="logo.ico">

    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>  <!-- Заголовок -->
                <RowDefinition Height="1"/>   <!-- Разделитель -->
                <RowDefinition Height="*"/>   <!-- Контент -->
                <RowDefinition Height="1"/>   <!-- Разделитель -->
                <RowDefinition Height="52"/>  <!-- Футер -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════
                 ЗАГОЛОВОК
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="0"
                  Background="{StaticResource SidebarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                        <!-- Иконка: шестерёнка -->
                        <Path Data="M 8,5.5 A 2.5,2.5 0 1,1 7.999,5.5 Z
                                    M 8,0 L 8,2 M 8,14 L 8,16
                                    M 0,8 L 2,8 M 14,8 L 16,8
                                    M 2.34,2.34 L 3.75,3.75 M 12.25,12.25 L 13.66,13.66
                                    M 13.66,2.34 L 12.25,3.75 M 3.75,12.25 L 2.34,13.66"
                              Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent"/>
                    </Viewbox>
                    <TextBlock Text="Настройки"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="Close_Click" ToolTip="Закрыть">
                    <Path Data="M 4.5,4.5 L 11.5,11.5 M 11.5,4.5 L 4.5,11.5"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <Rectangle Grid.Row="1" Fill="{StaticResource DividerBrush}"/>

            <!-- ══════════════════════════════════════════════
                 КОНТЕНТ
            ══════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,20,20,8">

                    <!-- ────────────────────────────────────────
                         СЕКЦИЯ: ТЕМА ОФОРМЛЕНИЯ
                    ──────────────────────────────────────── -->
                    <TextBlock Text="ТЕМА ОФОРМЛЕНИЯ"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal">
                        <!-- Тёмная — активная -->
                        <Button Style="{StaticResource ThemeButtonActiveStyle}"
                                ToolTip="Тёмная тема">
                            <TextBlock Text="Тёмная"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Button>
                        <!-- Светлая — неактивная -->
                        <Button Style="{StaticResource ThemeButtonStyle}"
                                Margin="6,0,0,0"
                                IsEnabled="False"
                                ToolTip="Будет доступно в следующих версиях">
                            <TextBlock Text="Светлая"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                        <!-- Системная — неактивная -->
                        <Button Style="{StaticResource ThemeButtonStyle}"
                                Margin="6,0,0,0"
                                IsEnabled="False"
                                ToolTip="Будет доступно в следующих версиях">
                            <TextBlock Text="Системная"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Светлая и системная тема будут доступны в следующих версиях"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Segoe UI" FontSize="11" FontStyle="Italic"
                               Margin="0,8,0,0"/>

                    <!-- ────────────────────────────────────────
                         СЕКЦИЯ: ГОРЯЧИЕ КЛАВИШИ
                    ──────────────────────────────────────── -->
                    <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Margin="0,28,0,14"/>

                    <!-- Запись -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="16" Height="16"
                                 Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12"
                                     Fill="{StaticResource RecordBrush}"/>
                        </Viewbox>
                        <TextBlock Grid.Column="1"
                                   Text="Запись"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="HkRecord"
                                Grid.Column="2"
                                Style="{StaticResource HotkeyInputStyle}"
                                Click="HotkeyButton_Click"
                                ToolTip="Нажмите, чтобы назначить горячую клавишу">
                            <TextBlock x:Name="HkRecordText"
                                       Text="—"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI" FontSize="12"/>
                        </Button>
                    </Grid>

                    <!-- Воспроизведение -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="16" Height="16"
                                 Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="M 3,2 L 14,8 L 3,14 Z"
                                  Fill="{StaticResource AccentBrush}"/>
                        </Viewbox>
                        <TextBlock Grid.Column="1"
                                   Text="Воспроизведение"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="HkPlay"
                                Grid.Column="2"
                                Style="{StaticResource HotkeyInputStyle}"
                                Click="HotkeyButton_Click"
                                ToolTip="Нажмите, чтобы назначить горячую клавишу">
                            <TextBlock x:Name="HkPlayText"
                                       Text="—"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI" FontSize="12"/>
                        </Button>
                    </Grid>

                    <!-- Пауза -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="16" Height="16"
                                 Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="M 3,2 L 6,2 L 6,14 L 3,14 Z
                                        M 10,2 L 13,2 L 13,14 L 10,14 Z"
                                  Fill="{StaticResource TextPrimaryBrush}"/>
                        </Viewbox>
                        <TextBlock Grid.Column="1"
                                   Text="Пауза"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="HkPause"
                                Grid.Column="2"
                                Style="{StaticResource HotkeyInputStyle}"
                                Click="HotkeyButton_Click"
                                ToolTip="Нажмите, чтобы назначить горячую клавишу">
                            <TextBlock x:Name="HkPauseText"
                                       Text="—"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI" FontSize="12"/>
                        </Button>
                    </Grid>

                    <!-- Стоп -->
                    <Grid Margin="0,10,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="16" Height="16"
                                 Margin="0,0,10,0" VerticalAlignment="Center">
                            <Rectangle Width="10" Height="10"
                                       Fill="{StaticResource TextPrimaryBrush}"/>
                        </Viewbox>
                        <TextBlock Grid.Column="1"
                                   Text="Стоп"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="HkStop"
                                Grid.Column="2"
                                Style="{StaticResource HotkeyInputStyle}"
                                Click="HotkeyButton_Click"
                                ToolTip="Нажмите, чтобы назначить горячую клавишу">
                            <TextBlock x:Name="HkStopText"
                                       Text="—"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI" FontSize="12"/>
                        </Button>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <Rectangle Grid.Row="3" Fill="{StaticResource DividerBrush}"/>

            <!-- ══════════════════════════════════════════════
                 ФУТЕР
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="4" Margin="20,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,8,0"
                            Click="Reset_Click"
                            ToolTip="Сбросить настройки до значений по умолчанию">
                        <TextBlock Text="Сбросить"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource ActionButtonAccentStyle}"
                            Click="Apply_Click"
                            ToolTip="Применить и сохранить настройки">
                        <TextBlock Text="Применить"
                                   Foreground="#141414"
                                   FontFamily="Segoe UI" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
