<UserControl x:Class="MiniMacroInstaller.Pages.FinishPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                Margin="28,0">

        <!-- Иконка успеха -->
        <Viewbox Width="48" Height="48"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,20">
            <Grid Width="48" Height="48">
                <Ellipse Fill="#1A3A2A" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"/>
                <Path Data="M 14,24 L 21,31 L 34,18"
                      Stroke="{StaticResource AccentBrush}"
                      StrokeThickness="2.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Fill="Transparent"/>
            </Grid>
        </Viewbox>

        <TextBlock x:Name="TitleText"
                   Text="Установка завершена!"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontFamily="Segoe UI" FontSize="20" FontWeight="Light"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <TextBlock x:Name="SubtitleText"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontFamily="Segoe UI" FontSize="13"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,32"/>

        <CheckBox x:Name="LaunchAppCheck"
                  Content="Запустить Mini Macro"
                  IsChecked="True"
                  HorizontalAlignment="Center"/>

    </StackPanel>
</UserControl>
