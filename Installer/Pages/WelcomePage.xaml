<UserControl x:Class="MiniMacroInstaller.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,24">

            <!-- Приветствие -->
            <TextBlock Text="Добро пожаловать"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontFamily="Segoe UI" FontSize="22" FontWeight="Light"
                       Margin="0,0,0,6"/>
            <TextBlock Text="Выберите версию Mini Macro для установки"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontFamily="Segoe UI" FontSize="13"
                       Margin="0,0,0,4"/>

            <!-- Определённая ОС -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <TextBlock Text="Обнаружена система:"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="Segoe UI" FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="OsText"
                           Foreground="{StaticResource AccentBrush}"
                           FontFamily="Segoe UI" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="5,0,0,0"/>
            </StackPanel>

            <!-- Карточки выбора версии -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Modern -->
                <ToggleButton x:Name="ModernCard"
                              Grid.Column="0"
                              Style="{StaticResource VersionCardStyle}"
                              Checked="ModernCard_Checked"
                              Unchecked="Card_Unchecked">
                    <StackPanel>
                        <!-- Иконка: молния / ракета — прямоугольник с галкой-акцент -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Path Data="M 9,1 L 5,9 L 9,9 L 7,15 L 13,7 L 9,7 Z"
                                      Fill="{StaticResource AccentBrush}"/>
                            </Viewbox>
                            <TextBlock Text="Modern"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text=".NET 10.0"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Windows 10 / 11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Рекомендуется"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </ToggleButton>

                <!-- Legacy -->
                <ToggleButton x:Name="LegacyCard"
                              Grid.Column="2"
                              Style="{StaticResource VersionCardStyle}"
                              Checked="LegacyCard_Checked"
                              Unchecked="Card_Unchecked">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Path Data="M 2,14 L 8,14 L 8,8 L 14,8 L 14,2 M 14,2 L 8,2 M 14,2 L 14,8"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"/>
                            </Viewbox>
                            <TextBlock Text="Legacy"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text=".NET Framework 4.8"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Windows 7 SP1 и выше"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Для старых систем"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <!-- Предупреждение о несовместимости ОС -->
            <Border x:Name="OsWarnBorder"
                    Background="#2A1A10"
                    BorderBrush="#5A3010"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,10"
                    Margin="0,16,0,0"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                        <Path Data="M 8,1 L 15,14 L 1,14 Z M 8,6 L 8,10 M 8,12 L 8,13"
                              Stroke="#E08030"
                              StrokeThickness="1.4"
                              StrokeLineJoin="Round"
                              Fill="Transparent"/>
                    </Viewbox>
                    <TextBlock x:Name="OsWarnText"
                               TextWrapping="Wrap"
                               Foreground="#E08030"
                               FontFamily="Segoe UI" FontSize="12"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
