<UserControl x:Class="MiniMacroInstaller.Pages.PathPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <StackPanel Margin="28,28,28,28">

        <TextBlock Text="Папка установки"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- Путь + кнопка обзора -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PathBox"
                     Grid.Column="0"
                     Style="{StaticResource PathBoxStyle}"
                     Text="C:\Program Files\Mini Macro"/>

            <Button Grid.Column="2"
                    Style="{StaticResource BrowseButtonStyle}"
                    Click="Browse_Click"
                    ToolTip="Выбрать папку">
                <Viewbox Width="14" Height="14">
                    <Path Data="M 1,4 L 6,4 L 8,2 L 15,2 L 15,12 L 1,12 Z"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.3" StrokeLineJoin="Round"
                          Fill="Transparent"/>
                </Viewbox>
            </Button>
        </Grid>

        <TextBlock x:Name="SpaceText"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontFamily="Segoe UI" FontSize="11"
                   Margin="0,0,0,28"/>

        <!-- Дополнительные параметры -->
        <TextBlock Text="ДОПОЛНИТЕЛЬНО"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                   Margin="0,0,0,14"/>

        <CheckBox x:Name="DesktopShortcut"
                  Content="Создать ярлык на рабочем столе"
                  IsChecked="True"
                  Margin="0,0,0,10"/>

        <CheckBox x:Name="StartMenuShortcut"
                  Content="Создать ярлык в меню Пуск"
                  IsChecked="True"/>

        <!-- Инфо о версии -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="4"
                Padding="14,12"
                Margin="0,28,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Width="14" Height="14" Margin="0,0,10,0"
                         VerticalAlignment="Top">
                    <Path Data="M 8,1 A 7,7 0 1,1 7.999,1 Z M 8,6 L 8,12 M 8,4 L 8,5"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.4"
                          Fill="Transparent"/>
                </Viewbox>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="VersionInfoTitle"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="Medium"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="VersionInfoText"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Segoe UI" FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

    </StackPanel>
</UserControl>
