<UserControl x:Class="MiniMacroInstaller.Pages.InstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <StackPanel Margin="28,28,28,28">

        <TextBlock Text="УСТАНОВКА"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                   Margin="0,0,0,20"/>

        <!-- Прогресс-бар -->
        <Grid Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock x:Name="StatusText"
                           Text="Подготовка..."
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="Segoe UI" FontSize="13"/>
                <TextBlock x:Name="PercentText"
                           Text="0%"
                           Foreground="{StaticResource AccentBrush}"
                           FontFamily="Segoe UI" FontSize="13"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- Кастомный прогресс-бар -->
            <Border Grid.Row="1"
                    Background="{StaticResource DividerBrush}"
                    CornerRadius="4">
                <Border x:Name="ProgressFill"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="4"
                        HorizontalAlignment="Left"
                        Width="0"/>
            </Border>
        </Grid>

        <!-- Лог установки -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="4"
                Margin="0,20,0,0">
            <ScrollViewer x:Name="LogScroll"
                          Height="220"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="2,2,0,2">
                <TextBlock x:Name="LogText"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="Consolas" FontSize="11"
                           Margin="12,10"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

    </StackPanel>
</UserControl>
