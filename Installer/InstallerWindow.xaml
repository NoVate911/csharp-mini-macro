<Window x:Class="MiniMacroInstaller.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:MiniMacroInstaller.Pages"
        Title="Mini Macro — Установка"
        Height="500" Width="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="logo.ico">

    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>  <!-- Заголовок -->
                <RowDefinition Height="64"/>  <!-- Шапка с шагами -->
                <RowDefinition Height="1"/>   <!-- Разделитель -->
                <RowDefinition Height="*"/>   <!-- Контент страницы -->
                <RowDefinition Height="1"/>   <!-- Разделитель -->
                <RowDefinition Height="60"/>  <!-- Навигация (Назад / Далее) -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════
                 ЗАГОЛОВОК
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="0"
                  Background="{StaticResource SidebarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="logo.ico" Width="16" Height="16" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Mini Macro — Установка"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Click="Minimize_Click" ToolTip="Свернуть">
                    <Path Data="M 5,8 L 11,8"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <Button Grid.Column="2"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="Close_Click" ToolTip="Отмена">
                    <Path Data="M 4.5,4.5 L 11.5,11.5 M 11.5,4.5 L 4.5,11.5"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- ══════════════════════════════════════════════
                 ИНДИКАТОР ШАГОВ
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Background="{StaticResource SidebarBrush}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- Шаг 1: Версия -->
                    <StackPanel x:Name="Step1Panel" Orientation="Horizontal">
                        <Ellipse x:Name="Step1Dot" Width="22" Height="22"
                                 Fill="{StaticResource AccentBrush}"/>
                        <TextBlock x:Name="Step1Num" Text="1"
                                   Foreground="#141414" FontFamily="Segoe UI"
                                   FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="-22,0,0,0" Width="22" TextAlignment="Center"/>
                        <TextBlock x:Name="Step1Text" Text="Версия"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Соединитель 1-2 -->
                    <Rectangle Width="32" Height="1"
                               Fill="{StaticResource DividerBrush}"
                               VerticalAlignment="Center" Margin="10,0"/>

                    <!-- Шаг 2: Путь -->
                    <StackPanel x:Name="Step2Panel" Orientation="Horizontal">
                        <Ellipse x:Name="Step2Dot" Width="22" Height="22"
                                 Fill="{StaticResource DividerBrush}"/>
                        <TextBlock x:Name="Step2Num" Text="2"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="-22,0,0,0" Width="22" TextAlignment="Center"/>
                        <TextBlock x:Name="Step2Text" Text="Путь"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Соединитель 2-3 -->
                    <Rectangle Width="32" Height="1"
                               Fill="{StaticResource DividerBrush}"
                               VerticalAlignment="Center" Margin="10,0"/>

                    <!-- Шаг 3: Установка -->
                    <StackPanel x:Name="Step3Panel" Orientation="Horizontal">
                        <Ellipse x:Name="Step3Dot" Width="22" Height="22"
                                 Fill="{StaticResource DividerBrush}"/>
                        <TextBlock x:Name="Step3Num" Text="3"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="-22,0,0,0" Width="22" TextAlignment="Center"/>
                        <TextBlock x:Name="Step3Text" Text="Установка"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Соединитель 3-4 -->
                    <Rectangle Width="32" Height="1"
                               Fill="{StaticResource DividerBrush}"
                               VerticalAlignment="Center" Margin="10,0"/>

                    <!-- Шаг 4: Готово -->
                    <StackPanel x:Name="Step4Panel" Orientation="Horizontal">
                        <Ellipse x:Name="Step4Dot" Width="22" Height="22"
                                 Fill="{StaticResource DividerBrush}"/>
                        <TextBlock x:Name="Step4Num" Text="4"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="-22,0,0,0" Width="22" TextAlignment="Center"/>
                        <TextBlock x:Name="Step4Text" Text="Готово"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="2" Fill="{StaticResource DividerBrush}"/>

            <!-- ══════════════════════════════════════════════
                 КОНТЕНТ (активная страница)
            ══════════════════════════════════════════════ -->
            <ContentControl x:Name="PageContent" Grid.Row="3"/>

            <Rectangle Grid.Row="4" Fill="{StaticResource DividerBrush}"/>

            <!-- ══════════════════════════════════════════════
                 НАВИГАЦИЯ
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="5" Margin="20,0">
                <Button x:Name="CancelButton"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click">
                    <TextBlock Text="Отмена"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Segoe UI" FontSize="12"/>
                </Button>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="BackButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="Back_Click">
                        <TextBlock Text="Назад"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"/>
                    </Button>
                    <Button x:Name="NextButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Next_Click">
                        <TextBlock x:Name="NextButtonText"
                                   Text="Далее"
                                   Foreground="#141414"
                                   FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="Medium"/>
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
