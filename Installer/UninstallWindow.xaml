<Window x:Class="MiniMacroInstaller.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление Mini Macro"
        Height="360" Width="460"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="logo.ico">

    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>  <!-- Заголовок -->
                <RowDefinition Height="1"/>   <!-- Разделитель -->
                <RowDefinition Height="*"/>   <!-- Контент -->
                <RowDefinition Height="1"/>   <!-- Разделитель -->
                <RowDefinition Height="60"/>  <!-- Футер -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════
                 ЗАГОЛОВОК
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="0"
                  Background="{StaticResource SidebarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <!-- Иконка: мусорная корзина -->
                    <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                        <Path Data="M 2,4 L 14,4 M 5,4 L 5,2 L 11,2 L 11,4
                                    M 3,4 L 4,14 L 12,14 L 13,4
                                    M 6,7 L 6,11 M 10,7 L 10,11"
                              Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"/>
                    </Viewbox>
                    <TextBlock Text="Удаление Mini Macro"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="Cancel_Click" ToolTip="Закрыть">
                    <Path Data="M 4.5,4.5 L 11.5,11.5 M 11.5,4.5 L 4.5,11.5"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <Rectangle Grid.Row="1" Fill="{StaticResource DividerBrush}"/>

            <!-- ══════════════════════════════════════════════
                 КОНТЕНТ
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="2">

                <!-- Панель подтверждения -->
                <StackPanel x:Name="ConfirmPanel" Margin="28,24,28,0">

                    <!-- Иконка предупреждения -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Viewbox Width="28" Height="28" Margin="0,0,14,0">
                            <Grid Width="28" Height="28">
                                <Ellipse Fill="#2A1A10"
                                         Stroke="#8A4010" StrokeThickness="1.5"/>
                                <Path Data="M 14,8 L 14,16 M 14,19 L 14,20"
                                      Stroke="#E08030"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Grid>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Удалить Mini Macro?"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Это действие нельзя отменить"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Путь установки -->
                    <TextBlock Text="ПАПКА УСТАНОВКИ"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="3"
                            Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="13" Margin="0,0,8,0">
                                <Path Data="M 1,4 L 6,4 L 8,2 L 15,2 L 15,12 L 1,12 Z"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.3" StrokeLineJoin="Round"
                                      Fill="Transparent"/>
                            </Viewbox>
                            <TextBlock x:Name="InstallDirText"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI" FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Будут удалены: программа, ярлыки и запись в реестре."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Segoe UI" FontSize="11"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Панель прогресса (видна во время удаления) -->
                <StackPanel x:Name="ProgressPanel"
                            Margin="28,24,28,0"
                            Visibility="Collapsed">

                    <TextBlock Text="УДАЛЕНИЕ"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <!-- Прогресс-бар -->
                    <Border Background="{StaticResource DividerBrush}"
                            CornerRadius="3" Height="4" Margin="0,0,0,16">
                        <Border x:Name="ProgressBar"
                                Background="{StaticResource RecordBrush}"
                                CornerRadius="3"
                                HorizontalAlignment="Left" Width="0"/>
                    </Border>

                    <!-- Лог -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="3">
                        <ScrollViewer x:Name="LogScroll"
                                      Height="140"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="LogText"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="Consolas" FontSize="11"
                                       Margin="12,10"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                </StackPanel>

            </Grid>

            <Rectangle Grid.Row="3" Fill="{StaticResource DividerBrush}"/>

            <!-- ══════════════════════════════════════════════
                 ФУТЕР
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="4" Margin="20,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="Cancel_Click">
                        <TextBlock Text="Отмена"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"/>
                    </Button>
                    <Button x:Name="UninstallButton"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="Uninstall_Click">
                        <TextBlock x:Name="UninstallButtonText"
                                   Text="Удалить"
                                   Foreground="White"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="Medium"/>
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
