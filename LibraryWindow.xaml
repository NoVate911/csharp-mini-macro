<Window x:Class="MiniMacro.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiniMacro"
        Title="Библиотека макросов"
        Height="520" Width="540"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="logo.ico">

    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>   <!-- Заголовок -->
                <RowDefinition Height="Auto"/> <!-- Папка -->
                <RowDefinition Height="1"/>    <!-- Разделитель -->
                <RowDefinition Height="Auto"/> <!-- Поиск -->
                <RowDefinition Height="*"/>    <!-- Список -->
                <RowDefinition Height="1"/>    <!-- Разделитель -->
                <RowDefinition Height="44"/>   <!-- Футер -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════
                 ЗАГОЛОВОК
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="0"
                  Background="{StaticResource SidebarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <!-- Иконка: список (библиотека) -->
                    <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                        <Path Data="M 1,4 L 15,4 M 1,8 L 15,8 M 1,12 L 15,12"
                              Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Viewbox>
                    <TextBlock Text="Библиотека макросов"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Закрыть (без свернуть — диалоговое окно) -->
                <Button Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="Close_Click" ToolTip="Закрыть">
                    <Path Data="M 4.5,4.5 L 11.5,11.5 M 11.5,4.5 L 4.5,11.5"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- ══════════════════════════════════════════════
                 ПУТЬ К ПАПКЕ С МАКРОСАМИ
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="16,12,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Иконка папки -->
                    <ColumnDefinition Width="*"/>    <!-- Путь -->
                    <ColumnDefinition Width="Auto"/> <!-- Кнопка смены -->
                </Grid.ColumnDefinitions>

                <!-- Иконка папки -->
                <Viewbox Grid.Column="0" Width="15" Height="15"
                         Margin="0,0,9,0" VerticalAlignment="Center">
                    <Path Data="M 1,4 L 6,4 L 8,2 L 15,2 L 15,12 L 1,12 Z"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.3"
                          StrokeLineJoin="Round"
                          Fill="Transparent"/>
                </Viewbox>

                <!-- Путь (тест) -->
                <TextBlock Grid.Column="1"
                           Text="C:\Users\NoVate\Documents\Macros"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="Segoe UI" FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Кнопка смены папки -->
                <Button Grid.Column="2"
                        Style="{StaticResource ActionButtonStyle}"
                        Padding="12,0"
                        ToolTip="Изменить папку с макросами">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="12" Height="12" Margin="0,0,5,0">
                            <!-- Иконка: карандаш (изменить) -->
                            <Path Data="M 11,2 L 14,5 L 5,14 L 2,14 L 2,11 Z M 9,4 L 12,7"
                                  Stroke="{StaticResource TextPrimaryBrush}"
                                  StrokeThickness="1.3"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock Text="Изменить"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Горизонтальный разделитель -->
            <Rectangle Grid.Row="2" Fill="{StaticResource DividerBrush}"/>

            <!-- ══════════════════════════════════════════════
                 ПОИСК
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="3" Margin="16,12,16,12">
                <!-- Иконка лупы и TextBox в одной ячейке: иконка — оверлей слева -->
                <TextBox Style="{StaticResource SearchBoxStyle}"
                         Tag="Поиск макроса..."
                         Padding="34,0,10,0"/>

                <Viewbox Width="14" Height="14"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Margin="11,0,0,0"
                         IsHitTestVisible="False">
                    <Path Data="M 6,1 A 5,5 0 1,1 5.999,1 Z M 9.5,9.5 L 14,14"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent"/>
                </Viewbox>
            </Grid>

            <!-- ══════════════════════════════════════════════
                 СПИСОК МАКРОСОВ
            ══════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="4"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <local:MacroItemControl MacroName="Приветственное сообщение"
                                            HotkeyText="Ctrl+F1"/>
                    <local:MacroItemControl MacroName="Авторизация"
                                            HotkeyText=""/>
                    <local:MacroItemControl MacroName="Шаблон письма"
                                            HotkeyText="Alt+E"/>
                    <local:MacroItemControl MacroName="Ежедневный отчёт"
                                            HotkeyText=""/>
                    <local:MacroItemControl MacroName="Запуск приложений"
                                            HotkeyText="Ctrl+Shift+L"/>
                    <local:MacroItemControl MacroName="Резервное копирование"
                                            HotkeyText="Ctrl+B"/>
                    <local:MacroItemControl MacroName="Открыть браузер"
                                            HotkeyText=""/>
                    <local:MacroItemControl MacroName="Снимок экрана"
                                            HotkeyText="Alt+S"/>
                    <local:MacroItemControl MacroName="Перезагрузка сети"
                                            HotkeyText=""/>
                    <local:MacroItemControl MacroName="Очистка временных файлов"
                                            HotkeyText="Ctrl+Shift+D"/>
                    <local:MacroItemControl MacroName="Переключение VPN"
                                            HotkeyText=""/>
                    <local:MacroItemControl MacroName="Ежемесячный отчёт"
                                            HotkeyText="Ctrl+M"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Горизонтальный разделитель перед футером -->
            <Rectangle Grid.Row="5" Fill="{StaticResource DividerBrush}"/>

            <!-- ══════════════════════════════════════════════
                 ФУТЕР: количество макросов
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="6" Margin="16,0">
                <TextBlock Text="12 макросов"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
