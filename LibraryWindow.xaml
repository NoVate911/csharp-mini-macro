<Window x:Class="MiniMacro.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiniMacro"
        Title="Библиотека макросов"
        Height="520" Width="540"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="logo.ico">

    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>   <!-- Заголовок -->
                <RowDefinition Height="Auto"/> <!-- Папка -->
                <RowDefinition Height="1"/>    <!-- Разделитель -->
                <RowDefinition Height="Auto"/> <!-- Поиск -->
                <RowDefinition Height="*"/>    <!-- Список -->
                <RowDefinition Height="1"/>    <!-- Разделитель -->
                <RowDefinition Height="44"/>   <!-- Футер -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════
                 ЗАГОЛОВОК
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="0"
                  Background="{StaticResource SidebarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                        <Path Data="M 1,4 L 15,4 M 1,8 L 15,8 M 1,12 L 15,12"
                              Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Viewbox>
                    <TextBlock Text="Библиотека макросов"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="Close_Click" ToolTip="Закрыть">
                    <Path Data="M 4.5,4.5 L 11.5,11.5 M 11.5,4.5 L 4.5,11.5"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- ══════════════════════════════════════════════
                 ПУТЬ К ПАПКЕ С МАКРОСАМИ
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="16,12,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Viewbox Grid.Column="0" Width="15" Height="15"
                         Margin="0,0,9,0" VerticalAlignment="Center">
                    <Path Data="M 1,4 L 6,4 L 8,2 L 15,2 L 15,12 L 1,12 Z"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.3" StrokeLineJoin="Round"
                          Fill="Transparent"/>
                </Viewbox>

                <TextBlock Grid.Column="1"
                           Text="C:\Users\NoVate\Documents\Macros"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="Segoe UI" FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="2"
                        Style="{StaticResource ActionButtonStyle}"
                        Padding="12,0"
                        ToolTip="Изменить папку с макросами">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="12" Height="12" Margin="0,0,5,0">
                            <Path Data="M 11,2 L 14,5 L 5,14 L 2,14 L 2,11 Z M 9,4 L 12,7"
                                  Stroke="{StaticResource TextPrimaryBrush}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round"
                                  Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock Text="Изменить"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Rectangle Grid.Row="2" Fill="{StaticResource DividerBrush}"/>

            <!-- ══════════════════════════════════════════════
                 ПОИСК — иконка встроена в шаблон SearchBoxStyle
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="3" Margin="16,12,16,12">
                <TextBox Style="{StaticResource SearchBoxStyle}"
                         Tag="Поиск макроса..."
                         TextChanged="Search_TextChanged"/>
            </Grid>

            <!-- ══════════════════════════════════════════════
                 СПИСОК МАКРОСОВ — заполняется из code-behind
            ══════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="4"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <!-- Пустое состояние: виден когда список пуст -->
                <Grid>
                    <StackPanel x:Name="MacroList"/>

                    <StackPanel x:Name="EmptyState"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <Viewbox Width="32" Height="32" Margin="0,0,0,12">
                            <Path Data="M 6,1 A 5,5 0 1,1 5.999,1 Z M 9.5,9.5 L 14,14"
                                  Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock Text="Ничего не найдено"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="13"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Rectangle Grid.Row="5" Fill="{StaticResource DividerBrush}"/>

            <!-- ══════════════════════════════════════════════
                 ФУТЕР
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="6" Margin="16,0">
                <TextBlock x:Name="CountText"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
